# Enable a cloud or local AI provider.
SCREENPLAY_AI_ENABLED=true

# DeepSeek example:
SCREENPLAY_AI_BASE_URL=https://api.deepseek.com
SCREENPLAY_AI_API_KEY=replace-with-your-api-key
SCREENPLAY_AI_MODEL=deepseek-chat

# Zhipu GLM example:
# SCREENPLAY_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# SCREENPLAY_AI_API_KEY=replace-with-your-glm-api-key
# SCREENPLAY_AI_MODEL=glm-4.5-air

# Any OpenAI Chat Completions compatible endpoint can be used here.
SCREENPLAY_AI_TIMEOUT_SECONDS=180
