{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/screenplay.schema.json",
  "title": "Novel Adaptation Screenplay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "characters",
    "locations",
    "props",
    "scenes",
    "adaptationNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "adaptationNotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adaptationNote"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sourceLanguage", "format", "sourceChapterCount", "formatProfile"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "sourceLanguage": {"type": "string", "minLength": 2},
        "format": {
          "type": "string",
          "enum": ["film", "tv_series", "web_series", "stage_play"]
        },
        "sourceChapterCount": {"type": "integer", "minimum": 3},
        "formatProfile": {"$ref": "#/$defs/formatProfile"}
      }
    },
    "formatProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetDurationMinutes", "structure", "pacing", "constraints"],
      "properties": {
        "targetDurationMinutes": {"type": "integer", "minimum": 1},
        "structure": {"type": "string", "minLength": 1},
        "pacing": {"type": "string", "minLength": 1},
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "visualWeight", "firstAppearance"],
      "properties": {
        "id": {"type": "string", "pattern": "^char_[0-9]{3,}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "age": {"type": ["string", "null"]},
        "gender": {"type": ["string", "null"]},
        "clothing": {"type": ["string", "null"]},
        "visualWeight": {"type": "integer", "minimum": 1, "maximum": 5},
        "firstAppearance": {"type": "string", "pattern": "^chapter_[0-9]{2,}$"}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "visualWeight"],
      "properties": {
        "id": {"type": "string", "pattern": "^loc_[0-9]{3,}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "timeOfDay": {"type": ["string", "null"]},
        "lightingMood": {"type": ["string", "null"]},
        "visualWeight": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "storyFunction", "firstAppearance"],
      "properties": {
        "id": {"type": "string", "pattern": "^prop_[0-9]{3,}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "storyFunction": {"type": "string"},
        "firstAppearance": {"type": "string", "pattern": "^chapter_[0-9]{2,}$"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceChapterIds",
        "heading",
        "purpose",
        "characters",
        "props",
        "beats",
        "continuity",
        "sourceFidelity"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^scene_[0-9]{3,}$"},
        "sourceChapterIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^chapter_[0-9]{2,}$"}
        },
        "heading": {"$ref": "#/$defs/heading"},
        "purpose": {"type": "string", "minLength": 1},
        "characters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^char_[0-9]{3,}$"}
        },
        "props": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^prop_[0-9]{3,}$"}
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/beat"}
        },
        "continuity": {"$ref": "#/$defs/continuity"},
        "sourceFidelity": {"$ref": "#/$defs/sourceFidelity"}
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "location", "time"],
      "properties": {
        "setting": {"type": "string", "enum": ["INT", "EXT", "INT/EXT"]},
        "location": {"type": "string", "minLength": 1},
        "time": {"type": "string", "enum": ["DAWN", "DAY", "DUSK", "NIGHT", "CONTINUOUS", "UNKNOWN"]}
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["action", "dialogue", "voice_over", "narration", "transition", "shot", "note"]
        },
        "characterId": {"type": ["string", "null"]},
        "parenthetical": {"type": ["string", "null"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousSceneId", "nextSceneId"],
      "properties": {
        "previousSceneId": {"type": ["string", "null"]},
        "nextSceneId": {"type": ["string", "null"]}
      }
    },
    "sourceFidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "inventedContent", "evidence"],
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "inventedContent": {"type": "boolean"},
        "evidence": {"type": "string", "maxLength": 80}
      }
    },
    "adaptationNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneId", "type", "description"],
      "properties": {
        "sceneId": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
